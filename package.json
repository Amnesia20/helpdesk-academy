{
  "name": "helpdesk-academy",
  "productName": "HelpDesk Academy",
  "version": "1.0.4",
  "description": "Help desk training simulator: students work realistic support tickets against AI-played callers, from easy to hard.",
  "author": "Levi M Wright",
  "homepage": "https://amnesia20.github.io/helpdesk-academy/",
  "desktopName": "helpdesk-academy.desktop",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "demo": "node server.js --demo",
    "app": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "node scripts/prepare-build.mjs && electron-builder --win --publish never",
    "dist:store": "node scripts/prepare-build.mjs && node scripts/dist-store.mjs",
    "dist:linux": "node scripts/prepare-build.mjs && electron-builder --linux --publish never",
    "site": "node scripts/update-site.mjs"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "electron-updater": "^6.8.12",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.helpdeskacademy.app",
    "productName": "HelpDesk Academy",
    "copyright": "Copyright (c) 2026 Levi M Wright",
    "publish": {
      "provider": "github",
      "owner": "Amnesia20",
      "repo": "helpdesk-academy",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "server.js",
      "src/**",
      "labs/**",
      "public/**",
      "electron/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "HelpDesk Academy",
      "artifactName": "HelpDesk-Academy-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "license": "build/license.txt"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "synopsis": "Help desk training simulator with AI callers",
      "maintainer": "Levi M Wright <49747321+Amnesia20@users.noreply.github.com>",
      "vendor": "Levi M Wright",
      "artifactName": "HelpDesk-Academy-${version}-Linux.${ext}",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "HelpDesk Academy",
          "Comment": "Help desk training with AI callers",
          "Keywords": "helpdesk;IT;support;training;simulator;"
        }
      }
    },
    "appx": {
      "identityName": "0xNull.HelpDeskAcademy",
      "publisher": "CN=7DE46B1C-E043-4E6B-8F86-32F290EF2E92",
      "publisherDisplayName": "0xNull",
      "applicationId": "HelpDeskAcademy",
      "displayName": "HelpDesk Academy",
      "backgroundColor": "#0f766e",
      "showNameOnTiles": true,
      "languages": [
        "en-US"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "artifactName": "HelpDesk-Academy-Store-${version}.msix"
    },
    "extraResources": [
      {
        "from": "LICENSE.md",
        "to": "LICENSE.md"
      }
    ]
  }
}
