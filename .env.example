# Copy this file to ".env" and fill in what you need. Restart the server after changes.

# ---- AI service: pick ONE ----
# Without any key, HelpDesk Academy runs in DEMO MODE (placeholder callers, rough grades).

# Option A: Groq's free tier. Free key at https://console.groq.com (no card needed).
# Good for testing and small groups; it has per-minute limits.
GROQ_API_KEY=

# Option B: Claude (paid, best quality). Key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# If both keys are set, Claude is used. Force one with:
# AI_PROVIDER=groq        (or: anthropic, or openai for any OpenAI-compatible server)

# Option C: any OpenAI-compatible server, e.g. Ollama running on this computer:
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1
# CALLER_MODEL=gpt-oss:20b

# ---- Classroom ----
# Password for the instructor dashboard (/instructor).
# Leave blank and one is generated and saved in data/instructor-password.txt
INSTRUCTOR_PASSWORD=

# Optional: students must enter this code to join. Leave blank to let anyone who can reach the server join.
CLASS_CODE=

# Port students connect to (http://<this-computer's-IP>:PORT)
PORT=3300

# ---- Optional tuning (defaults shown) ----
# Models. A comma-separated list means "use the first; switch to the next when one is rate limited".
# Claude defaults:  CALLER_MODEL=claude-opus-5-5   GRADER_MODEL=claude-opus-5-5
#   cheaper:        CALLER_MODEL=claude-haiku-5-5
# Groq defaults:    CALLER_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
#                   GRADER_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# CALLER_EFFORT=low
# GRADER_EFFORT=medium

# Guard rails per ticket attempt
# MAX_MESSAGES_PER_ATTEMPT=60
# MAX_HINTS_PER_ATTEMPT=3
# HINT_PENALTY=3

# ---- Hosting behind a web server (set automatically by deploy/oracle/setup.sh) ----
# PUBLIC_URL=https://myclass.duckdns.org
# HOST=127.0.0.1
# TRUST_PROXY=1
